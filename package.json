    "./migrations/*": "./migrations/*.mjs",
    "./bin/*": "./bin/*.mjs"
  },
  "bin": {
    "mwala": "bin/mwala.mjs"
  },
  "scripts": {
    "start": "node app.mjs",
    "cli": "node bin/mwala.mjs",
    "test": "echo \"No test specified\" && exit 0",
