{
  "name": "mwalajs",
  "version": "1.0.1",
  "description": "MwalaJS Framework CLI Tool",
  "type": "module",
  "main": "app.mjs",
  "scripts": {
    "start": "node app.mjs",
    "cli": "node bin/mwala.mjs"
  },
  "bin": {
    "mwala": "bin/mwala.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "mongodb": "^6.14.2",
    "mongoose": "^8.12.1",
    "mpath": "^0.9.0",
    "multer": "^1.4.2",
    "mysql2": "^3.13.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "readline-sync": "^1.4.10",
    "sequelize": "^6.37.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "nexe": "^5.0.0-beta.4",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "views/**/*",
      "public/**/*",
      "config/**/*.mjs",
      "runMigrations.mjs",
      "setupMwalajs.mjs",
      "createProject.mjs",
      ".env",
      "README.md",
      "package.json"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist"
  },
  "author": "HEKIMA AMBALILE MWALA",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
