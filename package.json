    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "fs-extra": "^11.3.4",
    "googleapis": "^171.4.0",
    "mongodb": "^6.14.2",
    "mongoose": "^8.12.1",
    "mpath": "^0.9.0",
    "multer": "^1.4.2",
    "mwalajs": "^1.1.19",
    "mysql2": "^3.13.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "open": "^11.0.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
