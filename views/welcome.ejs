      <p>Below is a simple **Hello World** example using MwalaJS:</p>
      <pre><code>
const Mwala = require('mwalajs');
const app = new Mwala();

app.get('/', (req, res) => {
    res.send('Hello, World!');
});

app.listen(3000, () => console.log('Server running on port 3000'));
      </code></pre>
